  "rules": {
    "restBetweenSetsSec": {
      "min": 120,
      "max": 180
    },
    "restBetweenExercisesSec": 60,
    "cardio": {
      "frequency": "daily",
      "timing": "Every morning or at the end of the workout",
      "type": "incline_walk",
      "durationMin": 30,
      "incline": 10,
      "speedKmh": 6
    }
  },
  "techniques": {
    "straight": {
      "name": "Straight Set",
      "description": "Normal sets with the same target reps."
    },
    "rpt": {
      "name": "Reverse Pyramid Training (RPT)",
      "description": "First set heaviest with the lowest reps (e.g. 6); then lower the weight and raise the reps (e.g. 8-10). End each set 1-2 reps short of failure (RIR 1-2)."
    },
    "rest_pause": {
      "name": "Rest-Pause (RP)",
      "description": "After the set, rest 10-15 s and do 3-5 more reps. Repeat 3 times: 12 reps - rest - 3/5 - rest - 3/5 - rest - 3/5.",
      "miniSets": 3,
      "miniSetRestSec": {
        "min": 10,
        "max": 15
      },
      "miniSetReps": {
        "min": 3,
        "max": 5
      }
    },
    "superset": {
      "name": "Superset (SS)",
      "description": "Do two exercises back to back without rest. One set of each + rest = 1 set."
    },
    "drop_set": {
      "name": "Drop Set",
      "description": "On the last set, reduce the weight 20-30% and continue to failure.",
      "dropPercent": {
        "min": 20,
        "max": 30
      }
    }
  },
  "nutrition": {
    "calorieDeficitKcal": {
      "min": 400,
      "max": 600
    },
    "proteinGPerKg": 2.0,
    "fatGPerKg": 0.8,
    "carbs": "remaining_calories",
    "note": "Carbs mostly before and after training. The goal is fat loss, not just weight: check the mirror, not only the scale."
  },
