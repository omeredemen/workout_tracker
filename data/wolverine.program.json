  "goal": "fat_loss",
  "durationWeeks": 12,
  "units": "kg",
  "weeklySchedule": {
    "mon": "upper_a",
    "tue": "lower_a",
    "wed": null,
    "thu": "upper_b",
    "fri": "lower_b",
    "sat": null,
    "sun": null
