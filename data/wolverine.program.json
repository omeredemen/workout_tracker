  "dayTemplates": {
    "upper_a": {
      "name": "Üst Vücut A",
      "focus": "Göğüs + Sırt + Omuz + Biceps + Triceps"
    },
    "lower_a": {
      "name": "Alt Vücut A",
      "focus": "Bacak"
    },
    "upper_b": {
      "name": "Üst Vücut B",
      "focus": "Göğüs + Sırt + Omuz + Biceps + Triceps"
    },
    "lower_b": {
      "name": "Alt Vücut B",
      "focus": "Bacak"
    }
